# Shopify Storefront API (server only; never prefix these with NEXT_PUBLIC_)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_WEBHOOK_SECRET=

# Customer Account API OAuth (values are shown in the Shopify customer account app settings)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_AUTH_URL=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_URL=
SHOPIFY_CUSTOMER_ACCOUNT_GRAPHQL_URL=
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=https://your-domain.example/account/callback

# Public site and consent-gated analytics
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Used only when the store_policy metaobject does not define the USD threshold
FREE_SHIPPING_THRESHOLD_USD=299
